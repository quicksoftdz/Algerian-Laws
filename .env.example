# Gemini
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# LM-Kit One upstream server as seen by the application server.
LMKIT_BASE_URL="http://127.0.0.1:5189"

# Optional LM-Kit API key.
LMKIT_API_KEY=""

# HTTP port for the Express gateway.
PORT="3000"

# Maximum time allowed for an LM-Kit request.
LMKIT_TIMEOUT_MS="120000"

# Public application URL.
APP_URL="MY_APP_URL"
