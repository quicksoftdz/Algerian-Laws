rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'kerbadou.g@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    match /users/{userId} {
      allow read: if true;
      allow create: if true;
      allow update: if isSignedIn() && (request.auth.uid == userId || isAdmin()) || request.resource.data.uid == userId;
      allow delete: if isAdmin();

      match /sessions/{sessionId} {
        allow read, write: if true;
      }

      match /settings/{docId} {
        allow read, write: if true;
      }
    }

    match /usernames/{username} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if isAdmin();
    }

    match /emails/{emailKey} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if isAdmin();
    }

    match /phones/{phoneKey} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if isAdmin();
    }

    match /system/{docId} {
      // All clients can read the active system AI configuration
      allow read: if true;
      // Only Administrators are permitted to configure AI models and providers
      allow write: if isAdmin();
    }

    match /admins/{adminId} {
      allow read: if true;
      allow write: if isAdmin() || request.resource.data.uid == adminId;
    }

    match /admin_logs/{logId} {
      // Read, list, delete are strictly restricted to Administrators
      allow read, delete: if isAdmin();
      // Log creation
      allow create: if true;
      allow update: if isAdmin();
    }

    match /shared_chats/{shareId} {
      // Anyone can read a shared temporary public chat session
      allow read: if true;
      // Anyone can create a shared read-only snapshot
      allow create: if true;
      // Shared snapshots are immutable once created
      allow update, delete: if isAdmin();
    }
  }
}
